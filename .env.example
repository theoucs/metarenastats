# Copie ce fichier en .env.local et remplis les valeurs.
# Aucune de ces variables n'est exposée au navigateur : tout passe par le serveur.

# Base Postgres (Supabase). La clé service_role contourne les RLS, elle ne doit
# jamais quitter le serveur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clé Riot. Une clé de développement expire toutes les 24 h ; le moteur de crawl
# s'arrête de lui-même quand l'API la refuse, plutôt que de tourner à vide.
RIOT_API_KEY=

# Protège les routes /api/cron/*, appelées par les workflows GitHub Actions.
# N'importe quelle chaîne aléatoire longue fait l'affaire.
CRON_SECRET=

# Facultatif — seulement pour `npm run screenshot`, qui pilote un Chrome déjà
# installé plutôt que d'en télécharger un.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
